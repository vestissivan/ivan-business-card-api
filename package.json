{
  "name": "ivan-temnikov-business-card-api",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only NestJS GraphQL business card with Prisma and automatic SQLite initialization",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "prisma generate && tsc && node scripts/copy-assets.cjs",
    "start": "node dist/main.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.cjs",
    "db:init": "node dist/database/seed-cli.js",
    "db:check": "node scripts/check-migrations.cjs",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "14.1.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/graphql": "14.1.0",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-sqlite3": "12.11.1",
    "graphql": "^16.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@vercel/nft": "^1.11.0",
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "typescript": "5.9.3"
  }
}
